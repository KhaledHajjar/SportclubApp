<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================
         Brand
         ============================================ -->
    <Color x:Key="BrandLight">#1D4ED8</Color>
    <Color x:Key="BrandDark">#3B82F6</Color>
    <Color x:Key="BrandStrongLight">#1E3A8A</Color>
    <Color x:Key="BrandStrongDark">#93C5FD</Color>

    <Color x:Key="AccentLight">#F87171</Color>
    <Color x:Key="AccentDark">#FCA5A5</Color>

    <!-- ============================================
         Surfaces & neutrals
         ============================================ -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#0B1220</Color>

    <Color x:Key="SurfaceElevatedLight">#F5F7FB</Color>
    <Color x:Key="SurfaceElevatedDark">#141C2F</Color>

    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="BorderDark">#27324A</Color>

    <Color x:Key="TextPrimaryLight">#0B1220</Color>
    <Color x:Key="TextPrimaryDark">#F1F5F9</Color>

    <Color x:Key="TextSecondaryLight">#5B6678</Color>
    <Color x:Key="TextSecondaryDark">#A0AABA</Color>

    <Color x:Key="TextOnBrand">#FFFFFF</Color>

    <!-- ============================================
         Semantic
         ============================================ -->
    <Color x:Key="SuccessLight">#16A34A</Color>
    <Color x:Key="SuccessDark">#34D399</Color>

    <Color x:Key="WarningLight">#F59E0B</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>

    <Color x:Key="DangerLight">#DC2626</Color>
    <Color x:Key="DangerDark">#F87171</Color>

    <Color x:Key="InfoLight">#0EA5E9</Color>
    <Color x:Key="InfoDark">#38BDF8</Color>

    <!-- Tinted backgrounds for banners (10% opacity of the semantic colour) -->
    <Color x:Key="WarningSurfaceLight">#FFF6E0</Color>
    <Color x:Key="WarningSurfaceDark">#3A2E12</Color>

    <Color x:Key="DangerSurfaceLight">#FEF1F1</Color>
    <Color x:Key="DangerSurfaceDark">#3F1A1A</Color>

    <Color x:Key="SuccessSurfaceLight">#E8F8EE</Color>
    <Color x:Key="SuccessSurfaceDark">#0F2A1B</Color>

    <Color x:Key="InfoSurfaceLight">#E6F4FB</Color>
    <Color x:Key="InfoSurfaceDark">#0F2436</Color>

    <!-- ============================================
         Convenience
         ============================================ -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0B1220</Color>
    <Color x:Key="Transparent">#00000000</Color>

</ResourceDictionary>
