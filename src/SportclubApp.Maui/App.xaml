<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:SportclubApp.Maui"
             xmlns:converters="clr-namespace:SportclubApp.Maui.Converters"
             x:Class="SportclubApp.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
            <toolkit:IsNullConverter x:Key="IsNullConverter" />
            <converters:WorkoutColorConverter x:Key="WorkoutColorConverter" />
            <converters:ToUpperConverter x:Key="ToUpperConverter" />
            <converters:FractionLengthConverter x:Key="FractionLengthConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
