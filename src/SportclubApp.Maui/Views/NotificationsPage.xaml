<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             xmlns:dtos="clr-namespace:SportclubApp.Shared.Dtos;assembly=SportclubApp.Shared"
             x:Class="SportclubApp.Maui.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mark all read"
                     Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Style="{StaticResource WarningBanner}"
                IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" />
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:NotificationDto">
                        <Grid Padding="{StaticResource ListItemPadding}"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="{StaticResource SpacingM}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding}" />
                            </Grid.GestureRecognizers>

                            <BoxView WidthRequest="10"
                                     HeightRequest="10"
                                     CornerRadius="5"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                                     VerticalOptions="Center"
                                     IsVisible="{Binding ReadUtc, Converter={StaticResource IsNullConverter}}" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Title}" Style="{StaticResource ListItemTitle}" />
                                <Label Text="{Binding Body}" />
                                <Label Text="{Binding CreatedUtc, StringFormat='{0:dddd, MMM d • HH:mm}'}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <ContentView>
                        <Label Text="No notifications yet."
                               Style="{StaticResource Caption}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Padding="{StaticResource SpacingXL}" />
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
