<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             xmlns:dtos="clr-namespace:SportclubApp.Shared.Dtos;assembly=SportclubApp.Shared"
             x:Class="SportclubApp.Maui.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BackgroundColor="#FFF3CD"
                Padding="12"
                IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" />
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Records}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:AttendanceRecordDto">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding WorkoutName}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding AttendedUtc, StringFormat='{0:dddd, MMM d • HH:mm}'}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <ContentView>
                        <Label Text="No attendance recorded for this year."
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Padding="32" />
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
