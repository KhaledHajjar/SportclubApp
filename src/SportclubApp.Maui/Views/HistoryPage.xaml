<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             xmlns:dtos="clr-namespace:SportclubApp.Shared.Dtos;assembly=SportclubApp.Shared"
             x:Class="SportclubApp.Maui.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Style="{StaticResource WarningBanner}"
                IsVisible="{Binding HasError}"
                Margin="20,12,20,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingM}">
                <Label Text="{Binding ErrorMessage}" VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Records}"
                            SelectionMode="None">

                <CollectionView.Header>
                    <ContentView Padding="20,12,20,0" />
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:AttendanceRecordDto">
                        <Border Margin="20,0,20,8"
                                Padding="{StaticResource CardPadding}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceElevatedDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="{StaticResource SpacingM}">
                                <!-- Workout color dot -->
                                <BoxView WidthRequest="10"
                                         HeightRequest="10"
                                         CornerRadius="5"
                                         BackgroundColor="{Binding WorkoutName, Converter={StaticResource WorkoutColorConverter}}"
                                         VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding WorkoutName}"
                                           Style="{StaticResource ListItemTitle}" />
                                    <Label Text="{Binding AttendedUtc, StringFormat='{0:dddd, MMM d • HH\\:mm}'}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding WorkoutName, Converter={StaticResource ToUpperConverter}}"
                                       Style="{StaticResource UppercaseMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <ContentView Padding="{StaticResource SpacingXL}">
                        <Label Text="No attendance recorded for this year."
                               Style="{StaticResource Caption}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
