<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             x:Class="SportclubApp.Maui.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Padding="24,12,24,32"
                             Spacing="{StaticResource SpacingM}">

            <Border Style="{StaticResource BrandMonogram}" HorizontalOptions="Center" Margin="0,12,0,0">
                <Label Text="S"
                       TextColor="{StaticResource White}"
                       FontFamily="OpenSansSemibold"
                       FontSize="40"
                       CharacterSpacing="-1"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Label Text="SPORTCLUB"
                   Style="{StaticResource UppercaseMuted}"
                   HorizontalOptions="Center"
                   CharacterSpacing="4"
                   Margin="0,8,0,0" />

            <Label Text="Join Sportclub"
                   Style="{StaticResource HeroTitle}"
                   HorizontalOptions="Center" />

            <Label Text="Create your account to start booking classes"
                   Style="{StaticResource Caption}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,16" />

            <Border Style="{StaticResource FormField}">
                <Entry Placeholder="First name"
                       Text="{Binding FirstName}" />
            </Border>

            <Border Style="{StaticResource FormField}">
                <Entry Placeholder="Last name"
                       Text="{Binding LastName}" />
            </Border>

            <Border Style="{StaticResource FormField}">
                <Entry Placeholder="Email"
                       Keyboard="Email"
                       Text="{Binding Email}" />
            </Border>

            <Border Style="{StaticResource FormField}">
                <Entry Placeholder="Password (at least 8 characters)"
                       IsPassword="True"
                       Text="{Binding Password}" />
            </Border>

            <Button Text="Create account"
                    Style="{StaticResource AccentButton}"
                    Command="{Binding SignUpCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Margin="0,12,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorText}"
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="Already have an account? Sign in"
                    Style="{StaticResource LinkButton}"
                    Command="{Binding BackToSignInCommand}"
                    HorizontalOptions="Center"
                    Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
