<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             x:Class="SportclubApp.Maui.Views.ClassDetailPage"
             x:DataType="vm:ClassDetailViewModel"
             Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpacingM}">

                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       IsVisible="{Binding HasError}" />

                <VerticalStackLayout IsVisible="{Binding HasSession}" Spacing="{StaticResource SpacingM}">
                    <Label Text="{Binding WorkoutName}" Style="{StaticResource PageTitle}" />

                    <Label Text="{Binding StartText}" FontSize="{StaticResource FontSizeBodyLarge}" />

                    <Label Text="Instructor" Style="{StaticResource FieldLabel}" Margin="{StaticResource MarginTopM}" />
                    <Label Text="{Binding InstructorName}" />

                    <Label Text="Location" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding LocationName}" />

                    <Label Text="Description" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding WorkoutDescription}" />

                    <BoxView Style="{StaticResource Divider}" Margin="{StaticResource MarginVerticalM}" />

                    <Label Text="{Binding CapacityText}" />
                    <Label Text="{Binding StatusText}"
                           Style="{StaticResource ListItemTitle}" />

                    <Button Text="Reserve"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding ReserveCommand}"
                            Margin="{StaticResource MarginTopM}" />

                    <Button Text="Join waiting list"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding JoinWaitingListCommand}"
                            IsVisible="{Binding CanJoinWaitingList}" />

                    <Button Text="Leave waiting list"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding LeaveWaitingListCommand}"
                            IsVisible="{Binding IsOnWaitingList}" />

                    <Label Text="You already have a reservation for this class."
                           Style="{StaticResource SuccessText}"
                           IsVisible="{Binding HasActiveReservation}"
                           HorizontalOptions="Center" />

                    <Label Text="You're on the waiting list — we'll notify you if a spot opens."
                           Style="{StaticResource InfoText}"
                           IsVisible="{Binding IsOnWaitingList}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
