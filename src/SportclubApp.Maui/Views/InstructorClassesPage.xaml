<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             xmlns:dtos="clr-namespace:SportclubApp.Shared.Dtos;assembly=SportclubApp.Shared"
             x:Class="SportclubApp.Maui.Views.InstructorClassesPage"
             x:DataType="vm:InstructorClassesViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Style="{StaticResource WarningBanner}"
                IsVisible="{Binding HasError}"
                Margin="20,12,20,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingM}">
                <Label Text="{Binding ErrorMessage}" VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Classes}" SelectionMode="None">

                <CollectionView.Header>
                    <ContentView Padding="20,12,20,0" />
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ClassSessionDto">
                        <Border Margin="20,0,20,12"
                                Padding="{StaticResource CardPadding}"
                                StrokeShape="RoundRectangle 18"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceElevatedDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                StrokeThickness="1">
                            <Border.Behaviors>
                                <toolkit:TouchBehavior
                                    DefaultScale="1"
                                    PressedScale="0.97"
                                    DefaultAnimationDuration="120"
                                    PressedAnimationDuration="80" />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InstructorClassesViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="{StaticResource SpacingM}">

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Workout.Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="18" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding StartUtc, StringFormat='{0:dddd, MMM d • HH\\:mm}'}"
                                                   Style="{StaticResource Caption}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Location.Name}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource WorkoutChip}"
                                            BackgroundColor="{Binding Workout.Name, Converter={StaticResource WorkoutColorConverter}}"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding Workout.Name, Converter={StaticResource ToUpperConverter}}"
                                               Style="{StaticResource WorkoutLabel}" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="{StaticResource SpacingM}"
                                      VerticalOptions="Center">

                                    <Border HeightRequest="6"
                                            StrokeShape="RoundRectangle 3"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource BorderDark}}"
                                            VerticalOptions="Center">
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding CapacityFraction, Converter={StaticResource FractionLengthConverter}, ConverterParameter='filled'}" />
                                                <ColumnDefinition Width="{Binding CapacityFraction, Converter={StaticResource FractionLengthConverter}, ConverterParameter='remaining'}" />
                                            </Grid.ColumnDefinitions>
                                            <BoxView Grid.Column="0"
                                                     BackgroundColor="{Binding Workout.Name, Converter={StaticResource WorkoutColorConverter}}" />
                                        </Grid>
                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="{Binding ReservedCount, StringFormat='{0} ATTENDING'}"
                                           Style="{StaticResource UppercaseAccent}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <ContentView Padding="{StaticResource SpacingXL}">
                        <Label Text="No classes assigned."
                               Style="{StaticResource Caption}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
