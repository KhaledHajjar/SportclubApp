<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             xmlns:dtos="clr-namespace:SportclubApp.Shared.Dtos;assembly=SportclubApp.Shared"
             x:Class="SportclubApp.Maui.Views.InstructorClassesPage"
             x:DataType="vm:InstructorClassesViewModel"
             Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Classes}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:ClassSessionDto">
                    <Grid Padding="{StaticResource ListItemPadding}" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InstructorClassesViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Workout.Name}" Style="{StaticResource ListItemTitle}" />
                            <Label Text="{Binding StartUtc, StringFormat='{0:dddd, MMM d • HH:mm}'}"
                                   Style="{StaticResource Caption}" />
                            <Label Text="{Binding Location.Name}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding ReservedCount, StringFormat='{0} attending'}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <ContentView>
                    <Label Text="No classes assigned."
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="{StaticResource SpacingXL}" />
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>
</ContentPage>
