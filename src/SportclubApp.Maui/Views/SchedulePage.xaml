<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             xmlns:dtos="clr-namespace:SportclubApp.Shared.Dtos;assembly=SportclubApp.Shared"
             xmlns:groups="clr-namespace:CommunityToolkit.Mvvm.Collections;assembly=CommunityToolkit.Mvvm"
             x:Class="SportclubApp.Maui.Views.SchedulePage"
             x:DataType="vm:ScheduleViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Style="{StaticResource WarningBanner}"
                IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingM}">
                <Label Text="{Binding ErrorMessage}" VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Groups}"
                            IsGrouped="True"
                            SelectionMode="None">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="groups:ObservableGroup(x:String, dtos:ClassSessionDto)">
                        <Label Text="{Binding Key}"
                               Style="{StaticResource SectionTitle}"
                               BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
                               Padding="16,8" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ClassSessionDto">
                        <Grid Padding="{StaticResource ListItemPadding}"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="{StaticResource SpacingM}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, Path=OpenClassCommand}"
                                    CommandParameter="{Binding}" />
                            </Grid.GestureRecognizers>

                            <Label Text="{Binding StartUtc, StringFormat='{0:HH\\:mm}'}"
                                   Style="{StaticResource ListItemTitle}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Workout.Name}" FontSize="{StaticResource FontSizeBodyLarge}" />
                                <Label Text="{Binding Location.Name}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding FreeSpots, StringFormat='{0} free'}"
                                   Style="{StaticResource SuccessText}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <ContentView>
                        <Label Text="No classes in the next 7 days."
                               Style="{StaticResource Caption}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Padding="{StaticResource SpacingXL}" />
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
