<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             x:Class="SportclubApp.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*" MinimumHeightRequest="640">
            <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource SpacingM}">

                <Border Style="{StaticResource BrandMonogram}" HorizontalOptions="Center">
                    <Label Text="S"
                           TextColor="{StaticResource White}"
                           FontFamily="OpenSansSemibold"
                           FontSize="40"
                           CharacterSpacing="-1"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="SPORTCLUB"
                       Style="{StaticResource UppercaseMuted}"
                       HorizontalOptions="Center"
                       CharacterSpacing="4"
                       Margin="0,8,0,0" />

                <Label Text="Welcome back"
                       Style="{StaticResource HeroTitle}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,20" />

                <Border Style="{StaticResource FormField}">
                    <Entry AutomationId="LoginEmail"
                           Placeholder="Email"
                           Keyboard="Email"
                           Text="{Binding Email}" />
                </Border>

                <Border Style="{StaticResource FormField}">
                    <Entry AutomationId="LoginPassword"
                           Placeholder="Password"
                           IsPassword="True"
                           Text="{Binding Password}" />
                </Border>

                <Button AutomationId="LoginSubmit"
                        Text="Sign in"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding SignInCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Margin="0,12,0,0" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />

                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       IsVisible="{Binding HasError}"
                       HorizontalOptions="Center" />

                <Button Text="Create account"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding GoToRegisterCommand}"
                        HorizontalOptions="Center"
                        Margin="0,12,0,0" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
