<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             x:Class="SportclubApp.Maui.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="16">

                <Grid HorizontalOptions="Center" WidthRequest="120" HeightRequest="120">
                    <Border StrokeShape="RoundRectangle 60"
                            BackgroundColor="LightGray">
                        <Label Text="{Binding InitialsFallback}"
                               FontSize="36"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasPhoto, Converter={StaticResource InvertedBoolConverter}, FallbackValue=true}" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 60"
                            IsVisible="{Binding HasPhoto}">
                        <Image Source="{Binding ProfilePhotoUrl}"
                               Aspect="AspectFill" />
                    </Border>
                </Grid>

                <Button Text="Change photo"
                        Command="{Binding ChangePhotoCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Label Text="Email" FontAttributes="Bold" />
                <Label Text="{Binding Email}" />

                <Label Text="First name" FontAttributes="Bold" />
                <Entry Text="{Binding FirstName}" />

                <Label Text="Last name" FontAttributes="Bold" />
                <Entry Text="{Binding LastName}" />

                <Label Text="Date of birth" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto">
                    <DatePicker Date="{Binding DateOfBirth}"
                                IsEnabled="{Binding HasDateOfBirth}" />
                    <Switch Grid.Column="1"
                            IsToggled="{Binding HasDateOfBirth}" />
                </Grid>

                <Button Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       IsVisible="{Binding HasError}" />

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,16" />

                <Label Text="Subscription"
                       FontSize="20"
                       FontAttributes="Bold" />

                <VerticalStackLayout IsVisible="{Binding HasSubscription}" Spacing="6">
                    <Label Text="{Binding SubscriptionTypeText}" FontSize="16" />
                    <Label Text="{Binding SubscriptionEndsText}" />
                    <Label Text="{Binding RemainingVisitsText}"
                           IsVisible="{Binding HasRemainingVisits}"
                           TextColor="DarkGreen" />
                </VerticalStackLayout>

                <Label Text="No active subscription."
                       IsVisible="{Binding HasSubscription, Converter={StaticResource InvertedBoolConverter}, FallbackValue=true}" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
