<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             x:Class="SportclubApp.Maui.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PagePadding}"
                                 Spacing="{StaticResource SpacingL}">

                <!-- Photo + email hero -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="{StaticResource SpacingM}">
                    <Grid WidthRequest="120" HeightRequest="120" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 60"
                                StrokeThickness="0"
                                Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                            <Label Text="{Binding InitialsFallback}"
                                   FontSize="40"
                                   FontFamily="OpenSansSemibold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding HasPhoto, Converter={StaticResource InvertedBoolConverter}, FallbackValue=true}" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 60"
                                StrokeThickness="0"
                                Stroke="Transparent"
                                IsVisible="{Binding HasPhoto}">
                            <Image Source="{Binding ProfilePhoto}"
                                   Aspect="AspectFill" />
                        </Border>
                    </Grid>
                    <Button Text="Change photo"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding ChangePhotoCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Label Text="{Binding Email}"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Subscription card -->
                <Border Style="{StaticResource Card}"
                        IsVisible="{Binding HasSubscription}">
                    <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="SUBSCRIPTION"
                                   Style="{StaticResource UppercaseMuted}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource WorkoutChip}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}">
                                <Label Text="{Binding PlanTierText, Converter={StaticResource ToUpperConverter}}"
                                       Style="{StaticResource WorkoutLabel}" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding PlanNameText}"
                               FontFamily="OpenSansSemibold"
                               FontSize="20" />
                        <Label Text="{Binding SubscriptionEndsText}"
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}"
                        IsVisible="{Binding HasSubscription, Converter={StaticResource InvertedBoolConverter}, FallbackValue=true}">
                    <Label Text="No active subscription."
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />
                </Border>

                <!-- Personal details -->
                <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                    <Label Text="PERSONAL DETAILS" Style="{StaticResource UppercaseMuted}" />

                    <Border Style="{StaticResource FormField}">
                        <Entry Placeholder="First name" Text="{Binding FirstName}" />
                    </Border>

                    <Border Style="{StaticResource FormField}">
                        <Entry Placeholder="Last name" Text="{Binding LastName}" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingM}">
                        <Border Style="{StaticResource FormField}">
                            <DatePicker Date="{Binding DateOfBirth}"
                                        IsEnabled="{Binding HasDateOfBirth}" />
                        </Border>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding HasDateOfBirth}"
                                VerticalOptions="Center" />
                    </Grid>

                    <Button Text="Save"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="0,8,0,0" />

                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           IsVisible="{Binding HasError}" />
                </VerticalStackLayout>

                <!-- Sign out -->
                <Button Text="Sign out"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SignOutCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
