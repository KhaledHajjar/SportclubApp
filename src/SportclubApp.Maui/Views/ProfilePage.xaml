<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportclubApp.Maui.ViewModels"
             x:Class="SportclubApp.Maui.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpacingM}">

                <Grid HorizontalOptions="Center" WidthRequest="120" HeightRequest="120">
                    <Border StrokeShape="RoundRectangle 60"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                        <Label Text="{Binding InitialsFallback}"
                               FontSize="36"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasPhoto, Converter={StaticResource InvertedBoolConverter}, FallbackValue=true}" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 60"
                            IsVisible="{Binding HasPhoto}">
                        <Image Source="{Binding ProfilePhoto}"
                               Aspect="AspectFill" />
                    </Border>
                </Grid>

                <Button Text="Change photo"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ChangePhotoCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Label Text="Email" Style="{StaticResource FieldLabel}" />
                <Label Text="{Binding Email}" />

                <Label Text="First name" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding FirstName}" />

                <Label Text="Last name" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding LastName}" />

                <Label Text="Date of birth" Style="{StaticResource FieldLabel}" />
                <Grid ColumnDefinitions="*,Auto">
                    <DatePicker Date="{Binding DateOfBirth}"
                                IsEnabled="{Binding HasDateOfBirth}" />
                    <Switch Grid.Column="1"
                            IsToggled="{Binding HasDateOfBirth}" />
                </Grid>

                <Button Text="Save"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       IsVisible="{Binding HasError}" />

                <BoxView Style="{StaticResource Divider}" Margin="{StaticResource MarginVerticalM}" />

                <Label Text="Subscription" Style="{StaticResource SectionTitle}" />

                <VerticalStackLayout IsVisible="{Binding HasSubscription}" Spacing="{StaticResource SpacingXS}">
                    <Label Text="{Binding PlanNameText}" FontSize="{StaticResource FontSizeBodyLarge}" />
                    <Label Text="{Binding PlanTierText}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding SubscriptionEndsText}" />
                </VerticalStackLayout>

                <Label Text="No active subscription."
                       Style="{StaticResource Caption}"
                       IsVisible="{Binding HasSubscription, Converter={StaticResource InvertedBoolConverter}, FallbackValue=true}" />

                <BoxView Style="{StaticResource Divider}" Margin="{StaticResource MarginVerticalM}" />

                <Button Text="Sign out"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SignOutCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
