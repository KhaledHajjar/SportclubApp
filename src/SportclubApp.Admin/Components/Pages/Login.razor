@page "/login"
@layout EmptyLayout
@inject IAdminApi AdminApi
@inject AdminAuthState Auth
@inject NavigationManager Nav

<PageTitle>Sportclub Admin · Sign in</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <div class="brand-monogram brand-monogram-lg">S</div>
        <p class="brand-overline">SPORTCLUB ADMIN</p>
        <h1 class="login-title">Sign in</h1>
        <p class="login-subtitle">Restricted access. Sign in with an admin account.</p>

        <div class="login-form">
            <label for="email">Email</label>
            <input id="email" type="email" class="login-input"
                   @bind="email" @bind:event="oninput"
                   placeholder="admin@sportclub.test"
                   autocomplete="username" />

            <label for="password">Password</label>
            <input id="password" type="password" class="login-input"
                   @bind="password" @bind:event="oninput"
                   placeholder="Password"
                   autocomplete="current-password"
                   @onkeydown="OnKeyDownAsync" />

            <button class="login-submit" @onclick="SignInAsync" disabled="@isBusy">
                @(isBusy ? "Signing in..." : "Sign in")
            </button>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="login-error">@error</p>
            }
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string? error;
    private bool isBusy;

    private async Task SignInAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Email and password are required.";
            return;
        }

        isBusy = true;
        try
        {
            var response = await AdminApi.LoginAsync(new LoginRequest(email.Trim(), password));
            if (!response.Roles.Contains(AuthRoles.Admin))
            {
                error = "This account is not authorised for the admin panel.";
                return;
            }

            Auth.Apply(response);
            Nav.NavigateTo("/");
        }
        catch (AdminApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            error = "Invalid email or password.";
        }
        catch (Exception)
        {
            error = "Could not reach the server. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isBusy)
        {
            await SignInAsync();
        }
    }
}
